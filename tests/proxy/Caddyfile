# Wie beispiele/internet/Caddyfile, nur ohne TLS und ohne Namen -- fuer den
# Integrationstest, der keine echte Domain hat.
{
    admin off
    auto_https off

    # Fehlermeldungen von Caddy (etwa 502, solange rtsp2jpeg neu startet)
    # nennen die angefragte URL. Das Token darin wird vor dem Schreiben
    # ersetzt.
    log default {
        output stderr
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }
}

:80 {
    @erlaubt path /cam/*
    handle @erlaubt {
        reverse_proxy rtsp2jpeg:8080
    }
    handle {
        respond "Nicht verfuegbar" 404
    }
}
