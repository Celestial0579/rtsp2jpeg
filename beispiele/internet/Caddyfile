# Caddy als vorgelagerter Webserver: besorgt selbsttaetig ein
# Let's-Encrypt-Zertifikat und reicht die Anfragen weiter.
#
# Voraussetzungen:
#   - Der Name zeigt per A-/AAAA-Eintrag auf diesen Rechner.
#   - Port 80 und 443 sind aus dem Internet erreichbar.
#
# Den Namen unten ersetzen. Die E-Mail-Adresse bekommt die Warnung,
# falls die Verlaengerung eines Zertifikats scheitert.

{
    email admin@example.de

    # Fehlermeldungen von Caddy (etwa 502, solange rtsp2jpeg neu startet)
    # nennen die angefragte URL. Das Token darin wird vor dem Schreiben
    # ersetzt.
    log default {
        output stderr
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }
}

tuerkamera.example.de {
    encode zstd gzip

    # Nur das, was STARFACE braucht. rtsp2jpeg kennt ohnehin nichts
    # anderes; Caddy grenzt zusaetzlich ab.
    @erlaubt path /cam/*
    handle @erlaubt {
        reverse_proxy rtsp2jpeg:8080
    }

    handle {
        respond "Nicht verfuegbar" 404
    }

    # Absichtlich kein Zugriffsprotokoll: Caddy schriebe die ganze URL
    # hinein, also auch das Token aus ?token=... Wer eins einschaltet,
    # braucht dort denselben Filter wie oben.
}
